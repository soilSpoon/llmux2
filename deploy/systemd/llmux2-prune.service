[Unit]
Description=Regenerate llmux2 config without dead routes and deploy it
# Requires ~/llmux2/import.flags carrying the site's supplemental importer
# arguments and an ExecStartPre drop-in that refreshes export.json (the
# export contains credentials).

[Service]
Type=oneshot
WorkingDirectory=%h/llmux2
ExecStart=/bin/bash %h/llmux2/bin/llmux2-prune.sh
UMask=0077
