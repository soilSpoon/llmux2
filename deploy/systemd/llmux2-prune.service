[Unit]
Description=Regenerate llmux2 config without dead routes and deploy it
# Requires ~/llmux2/import.env carrying the site's supplemental importer
# arguments (IMPORT_FLAGS bash array), ~/llmux2/site.toml carrying the site
# overlay (an empty file is a valid no-op), and an ExecStartPre drop-in that
# refreshes export.json (the export contains credentials and is shredded
# after the import consumes it).

[Service]
Type=oneshot
WorkingDirectory=%h/llmux2
ExecStart=/bin/bash %h/llmux2/bin/llmux2-prune.sh
UMask=0077
