[Unit]
Description=Sweep all llmux2 routes daily for dead upstreams

[Timer]
# Calendar + jitter: enabling the timer never fires a sweep immediately, and
# the full sweep lands at a randomized off-peak point each day.
OnCalendar=daily
RandomizedDelaySec=86400
Unit=llmux2-sweep.service

[Install]
WantedBy=timers.target
