[Unit]
Description=Full-catalog probe sweep for the running llmux2 gateway

[Service]
Type=oneshot
WorkingDirectory=%h/llmux2
# OCI slots listen on 127.0.0.1:8090; the flag overrides the 127.0.0.1:8080
# default. The sweep uses its own state file so the rotation cursor and the
# curated --models pin on llmux2-probe.service are unaffected. --dead-file
# feeds llmux-import --exclude-models (see llmux2-prune.service).
ExecStart=%h/llmux2/bin/llmux2-probe --listen 127.0.0.1:8090 --sweep --state-file %h/llmux2/probe-sweep-state.json --dead-file %h/llmux2/dead-models.json
UMask=0077
